model User {
  id            String         @id @default(uuid())
  tenantId      String
  email         String
  role          UserRole       @default(RECEPTIONIST)
  firstName     String
  lastName      String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  professional  Professional?
  refreshTokens RefreshToken[]
  identities    UserIdentity[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referralCodes ReferralCode[] @relation("UserReferrals")

  @@unique([tenantId, email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── System Admin Users (Backoffice) ────────────────────────────────────────
// Tabla separada e independiente de los usuarios de tenants.
// No tiene tenantId ni UserRole — es exclusiva para administradores del sistema.

model SystemUser {
  id            String               @id @default(uuid())
  email         String               @unique
  firstName     String
  lastName      String
  passwordHash  String
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  refreshTokens SystemRefreshToken[]

  @@map("system_users")
}

model SystemRefreshToken {
  id           String     @id @default(uuid())
  systemUserId String
  token        String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  systemUser   SystemUser @relation(fields: [systemUserId], references: [id], onDelete: Cascade)

  @@map("system_refresh_tokens")
}

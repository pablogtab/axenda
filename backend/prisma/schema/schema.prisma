generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
}

enum TenantMode {
  GENERIC
  BARBERSHOP
  MEDICAL
  LEGAL
  FITNESS
  EDUCATION
  TECHNICAL
  BEAUTY
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  RECEPTIONIST
  PROFESSIONAL
}

enum ExceptionType {
  BLOCK
  HOLIDAY
  LEAVE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  WAITING
}

enum BookingSource {
  PANEL
  PUBLIC_LINK
  WIDGET
  QR
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

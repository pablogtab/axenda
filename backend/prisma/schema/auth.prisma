// ─── Verification Codes ──────────────────────────────────

model VerificationCode {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  payload   Json?    // Para guardar datos temporales como el organizationName
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_codes")
}
// ─── User Identities ─────────────────────────────────────

model UserIdentity {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     AuthProvider
  providerId   String?      // googleId o email según el provider
  passwordHash String?      // solo para provider EMAIL
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([provider, providerId])
  @@map("user_identities")
}

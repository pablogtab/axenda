model Tenant {
  id                              String                @id @default(uuid())
  name                            String
  slug                            String                @unique
  mode                            TenantMode            @default(GENERIC)
  timezone                        String                @default("America/Argentina/Buenos_Aires")
  currency                        String                @default("ARS")
  logoUrl                         String?
  active                          Boolean               @default(true)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  bannerUrl                       String?
  publicSlug                      String?               @unique
  accentColor                     String?               @default("#a855f7")
  backgroundColor                 String?               @default("#0a0b14")
  primaryColor                    String?               @default("#6366f1")
  primaryHoverColor               String?               @default("#4f46e5")
  textColor                       String?               @default("#f8fafc")
  publicShowBranchSelection       Boolean               @default(true)
  publicShowProfessionalSelection Boolean               @default(true)
  publicMaxOverlapMins            Int                   @default(15)
  publicMaxBookingDays            Int                   @default(30)
  publicMinBookingTime            String                @default("1h")
  onboardingCompleted             Boolean               @default(false)
  whatsappReminder                Boolean               @default(false)
  confirmEmail                    Boolean               @default(true)
  allowReschedule                  Boolean               @default(true)
  whatsappCancellation            Boolean               @default(true)
  address                         String?
  category                        String?
  email                           String?
  phone                           String?
  appointments                    Appointment[]
  branches                        Branch[]
  clients                         Client[]
  professionals                   Professional[]
  serviceCategories               ServiceCategory[]
  services                        Service[]
  paymentConfig                   TenantPaymentConfig?
  subscription                    TenantSubscription?
  whatsappConfig                  TenantWhatsappConfig?
  whatsappPacks                   TenantWhatsappPack[]
  users                           User[]

  @@map("tenants")
}

model Branch {
  id            String               @id @default(uuid())
  tenantId      String
  name          String
  address       String?
  phone         String?
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  appointments  Appointment[]
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals ProfessionalBranch[]

  @@map("branches")
}

# ─── Database ───────────────────────────────────────────
POSTGRES_USER=axenda
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=axenda_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://axenda:your_password_here@localhost:5432/axenda_db?schema=public"

# ─── Redis ──────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=your_very_long_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_very_long_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
API_URL=http://localhost:3000

# ─── Storage ────────────────────────────────────────────
# Options: local, gcs
STORAGE_TYPE=local
GCS_BUCKET_NAME=my-axenda-bucket
GOOGLE_APPLICATION_CREDENTIALS=path/to/key.json

# ─── Resend SMTP ───────────────────────────────────────
LOCAL_EMAIL=true
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASSWORD=re_your_api_key_here
MAIL_FROM="Axenda <info@axenda.ar>"

# ─── WhatsApp ──────────────────────────────────────────
WPP_DEFAULT_PHONE_ID=your_default_phone_id
WPP_DEFAULT_WABA_ID=your_default_waba_id
WPP_DEFAULT_ACCESS_TOKEN=your_meta_access_token
WPP_WEBHOOK_VERIFY_TOKEN=your_verify_token_here
WPP_SYNC_TEMPLATES=true

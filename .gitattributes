# Normalize line endings
* text=auto eol=lf

# Force LF for these file types
*.ts    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.prisma text eol=lf
*.sql   text eol=lf
*.env*  text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.ico   binary
*.wasm  binary

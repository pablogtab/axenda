{
  "name": "axenda",
  "version": "1.0.5",
  "description": "Axenda CRM - Professional Scheduling System",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start:frontend": "npm run start --workspace=frontend",
    "start:mobile": "npm run start:mobile --workspace=frontend",
    "start:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "install:all": "npm install",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "dev": "npx concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "mcp": "mcp-remote https://mcp.mercadopago.com/mcp --transport sse",
    "tunnel": "ssh -N -L 8181:localhost:81 -L 5433:localhost:5432 -R 8080:localhost:4200 -R 8081:localhost:3000 root@167.86.89.240"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
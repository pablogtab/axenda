# ─── Database ───────────────────────────────────────────
POSTGRES_USER=axenda
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=axenda_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://axenda:your_password_here@localhost:5432/axenda_db?schema=public"

# ─── Redis ──────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=your_very_long_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_very_long_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
